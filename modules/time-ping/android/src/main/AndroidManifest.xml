<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions for the full-screen category ping. This manifest is MERGED into the host
      app's manifest at build time, so the permission set stays co-located with the code
      that needs it. Justifications (also required for the Play data-safety form):

      · USE_FULL_SCREEN_INTENT — post a notification whose `setFullScreenIntent` launches
          PingActivity OVER the lock screen / when the screen is off. This is the whole
          point of the app (one-tap logging from the lock screen). On Android 14+ it is a
          "special access" permission: the mere declaration only allows the request; the
          user must additionally grant it in Settings (canUseFullScreenIntent). tools:ignore
          silences the lint note that it can't be a normal runtime request.
      · SCHEDULE_EXACT_ALARM — pings must land ON the slot boundary (:00/:15/…), not "some
          time in the next batching window". Only setExact* honours that. Also a special
          access on Android 12+ (canScheduleExactAlarms); we degrade to inexact
          setAndAllowWhileIdle when it isn't granted so pings still fire, just less punctually.
      · POST_NOTIFICATIONS — the full-screen intent is delivered THROUGH a notification, and
          Android 13+ requires runtime consent before any notification (incl. the FSI one)
          can be posted. Without it the chooser can't be surfaced.
      · RECEIVE_BOOT_COMPLETED — AlarmManager's queue is wiped on reboot. BootReceiver
          re-arms the pings from the persisted params so a restart doesn't silently stop the
          audit (fixes the known reboot landmine).
      · REQUEST_IGNORE_BATTERY_OPTIMIZATIONS — Doze / aggressive OEM battery managers can
          defer even setExactAndAllowWhileIdle alarms. Letting the user exempt the app keeps
          the cadence reliable on the phones (Xiaomi/Samsung/etc.) that need it most.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:ignore="ProtectedPermissions" />
    <!--
      SYSTEM_ALERT_WINDOW ("Display over other apps") — the reliable way to make the chooser
      cover the WHOLE screen while the phone is unlocked/in use. A full-screen INTENT only
      launches its activity when the device is locked/asleep (and on Android 14+ degrades to a
      heads-up without the FSI special access); this permission additionally lifts the
      background-activity-launch restriction so PingReceiver can start PingActivity directly.
      Settings-granted ("Display over other apps"), same as Mr. Productive's block screen.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <!--
      FOREGROUND_SERVICE (+ FOREGROUND_SERVICE_SPECIAL_USE on API 34+) — PingOverlayService runs
      as a foreground service so it may draw the full-screen chooser OVERLAY window while the
      phone is unlocked/in use. Starting the chooser as an Activity from a background alarm is
      blocked by the Android 14/15 background-activity-launch restriction (it degrades the
      full-screen intent to a heads-up); a foreground service + SYSTEM_ALERT_WINDOW overlay is
      the reliable full-screen path (same mechanism as Mr. Productive's block screen).
      "specialUse" is the honest FGS subtype — none of the predefined subtypes describe a
      transient check-in chooser.
      WAKE_LOCK — the service briefly acquires a SCREEN_BRIGHT wakelock (~30s) so a ping that
      lands as the display is dimming still wakes the screen to show the chooser.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!--
          The full-screen chooser. Launched by the FSI notification (and by the
          fullScreenIntent PendingIntent) so it appears over everything, including the lock
          screen with the screen off.
            · exported=false        — only our own notification / broadcast may start it.
            · excludeFromRecents     — a transient popup shouldn't linger in the recents list.
            · launchMode=singleTask  — a second ping while one is up reuses the instance
                                       instead of stacking chooser on chooser.
            · Translucent.NoTitleBar theme — the activity paints its own dark full-bleed
                                       surface (built in Kotlin, no res/); the translucent
                                       system theme avoids a white flash before onCreate draws.
          showWhenLocked / turnScreenOn are set in code (setShowWhenLocked/setTurnScreenOn on
          API 27+, window flags below that) for the widest API compatibility rather than via
          the manifest-only android:showWhenLocked attribute.
        -->
        <activity
            android:name="agency.lumieremedia.timeaudit.timeping.PingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:ignore="LockedOrientationActivity" />

        <!--
          The UNLOCKED / in-use ping surface: a foreground service that draws the category
          chooser as a full-screen SYSTEM_ALERT_WINDOW overlay. Used instead of launching
          PingActivity from the background (which Android 14/15 degrades to a heads-up). The
          locked / screen-off case still uses PingActivity via the FSI notification.
            · exported=false            — only our own PingReceiver may start it.
            · foregroundServiceType=specialUse — required on API 34+ and must match the type
                                         passed to startForeground(); the property string is the
                                         human justification surfaced to Play reviewers.
        -->
        <service
            android:name="agency.lumieremedia.timeaudit.timeping.PingOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Time-audit check-in: briefly draws a full-screen category chooser over the screen when a scheduled 15-minute ping fires, dismissed as soon as the user taps a category." />
        </service>

        <!--
          Receives the AlarmManager broadcast (ACTION_FIRE) to post the FSI notification and
          chain the next alarm, and the notification's quick-action broadcasts (ACTION_PICK)
          to record a PendingLog without opening the chooser. exported=false: only our own
          explicit intents (alarms + our own notification actions) target it.
        -->
        <receiver
            android:name="agency.lumieremedia.timeaudit.timeping.PingReceiver"
            android:exported="false" />

        <!--
          Re-arms the ping schedule after a reboot from the params persisted in PingStore.
          exported=true is REQUIRED for the system to deliver BOOT_COMPLETED to us. We also
          catch the OEM "quickboot"/HTC poweron aliases some devices send instead.
        -->
        <receiver
            android:name="agency.lumieremedia.timeaudit.timeping.BootReceiver"
            android:exported="true"
            android:enabled="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
